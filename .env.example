# Copy this file to .env and fill in your key: https://openrouter.ai/keys

OPENROUTER_API_KEY=

# Model used by the Digital Twin on OpenRouter (primary provider).
TWIN_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional: your site URL, sent to OpenRouter for app attribution.
TWIN_SITE_URL=

# Optional fallback provider (Groq). The twin uses OpenRouter first and only
# calls Groq when OpenRouter is rate-limited or down. Inactive without a key.
# Note: Groq hosts no free models; cheapest is openai/gpt-oss-20b ($0.075/M in).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
